# API Configuration
VITE_API_URL=http://localhost:8080

# Service Ports (for reference)
# Auth Service: 8081
# Flight Service: 8082
# Seat Service: 8083
# Booking Service: 8084
# Passenger Service: 8085
# Payment Service: 8086
# Notification Service: 8087
# Airline-Airport Service: 8088

# Note: In Vite, environment variables must be prefixed with VITE_ to be exposed to the client
# Example: VITE_API_URL, VITE_APP_NAME, etc.
